[node name="QuickResolveConfirmationDialog" type="ConfirmationDialog" parent="."]
title = "Quick Resolve Battle?"
initial_position = 1
exclusive = true
dialog_hide_on_ok = false
ok_button_text = "Resolve Battle"
dialog_text = "Quick Resolve automatically plays the remaining battle.

Surviving armies keep permanent casualties, commanders may use mana, and the final outcome applies normal victory, defeat, and objective consequences.

This cannot be undone."

[node name="WithdrawalConfirmationDialog" type="ConfirmationDialog" parent="."]
title = "Confirm Withdrawal?"
initial_position = 1
exclusive = true
dialog_hide_on_ok = false
ok_button_text = "Confirm Withdrawal"
dialog_text = "Confirm this army-wide battle exit order?"

