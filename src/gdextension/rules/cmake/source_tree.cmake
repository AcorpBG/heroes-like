# cmake -DROOT=<repo root> -DOUT=<header> [-DOVERRIDE=<sha>] -P source_tree.cmake
#
# Writes the git tree id of src/gdextension/rules as it is on disk, committed
# or not, into a header. It is the id `git rev-parse <commit>:src/gdextension/rules`
# prints for the commit that holds these sources, so a loaded library can be
# matched to its sources. A build from a source archive passes OVERRIDE.
set(tree "unknown")
if(DEFINED OVERRIDE AND NOT OVERRIDE STREQUAL "")
	set(tree "${OVERRIDE}")
else()
	find_package(Git QUIET)
	if(GIT_FOUND)
		string(RANDOM LENGTH 12 suffix)
		set(index "${CMAKE_CURRENT_BINARY_DIR}/rules-source-tree-${suffix}.index")
		execute_process(
			COMMAND "${CMAKE_COMMAND}" -E env "GIT_INDEX_FILE=${index}" "${GIT_EXECUTABLE}" -C "${ROOT}" add -A -- src/gdextension/rules
			RESULT_VARIABLE add_result OUTPUT_QUIET ERROR_QUIET)
		if(add_result EQUAL 0)
			execute_process(
				COMMAND "${CMAKE_COMMAND}" -E env "GIT_INDEX_FILE=${index}" "${GIT_EXECUTABLE}" -C "${ROOT}" write-tree --prefix=src/gdextension/rules/
				OUTPUT_VARIABLE written OUTPUT_STRIP_TRAILING_WHITESPACE
				RESULT_VARIABLE write_result ERROR_QUIET)
			if(write_result EQUAL 0 AND written MATCHES "^[0-9a-f]+$")
				set(tree "${written}")
			endif()
		endif()
		file(REMOVE "${index}")
	endif()
endif()

set(content "// Generated by src/gdextension/rules/cmake/source_tree.cmake.\n#pragma once\n#define AURELION_RULES_SOURCE_TREE \"${tree}\"\n")
set(previous "")
if(EXISTS "${OUT}")
	file(READ "${OUT}" previous)
endif()
if(NOT previous STREQUAL content)
	file(WRITE "${OUT}" "${content}")
endif()
