; Engine configuration file.
; This is intentionally minimal yet runnable.

; WARNING: Keep these settings in sync with execution docs in project.md and PLAN.md.
config_version=5

[accessibility]
general/accessibility_support=0

[application]
config/name="heroes-like"
config/version="0.1.0-alpha.1"
run/main_scene="res://scenes/boot/Boot.tscn"
run/flush_stdout_on_print=true
config/features=PackedStringArray("4.2")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.00784314, 0.0156863, 0.027451, 1)
boot_splash/image="res://art/ui/branding/aurelion_reach_frontier_crest.png"
boot_splash/minimum_display_time=0
boot_splash/show_image=true
boot_splash/stretch_mode=1
boot_splash/use_filter=true

[autoload]
ContentService="*res://scripts/autoload/ContentService.gd"
SessionState="*res://scripts/autoload/SessionState.gd"
SaveService="*res://scripts/autoload/SaveService.gd"
CampaignProgression="*res://scripts/autoload/CampaignProgression.gd"
SettingsService="*res://scripts/autoload/SettingsService.gd"
RuntimeIssueLog="*res://scripts/autoload/RuntimeIssueLog.gd"
UiAudio="*res://scripts/autoload/UiAudio.gd"
PresentationAudio="*res://scripts/autoload/PresentationAudio.gd"
AmbientAudio="*res://scripts/autoload/AmbientAudio.gd"
MusicAudio="*res://scripts/autoload/MusicAudio.gd"
AppRouter="*res://scripts/autoload/AppRouter.gd"
LiveValidationHarness="*res://scripts/autoload/LiveValidationHarness.gd"
UiAccessibility="*res://scripts/autoload/UiAccessibility.gd"

[debug]
file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true
file_logging/log_path="user://logs/godot.log"
file_logging/max_log_files=5

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]
name="heroes-like"
