  "MiniMaxH3AddGuide": {
    "input": {
      "required": {
        "positive": [
          "CONDITIONING",
          {}
        ],
        "latent": [
          "LATENT",
          {}
        ],
        "frame_idx": [
          "INT",
          {
            "tooltip": "Frame index to anchor the image or the clip's first frame at. Negative values are counted from the end of the video.",
            "default": 0,
            "min": -9999,
            "max": 9999
          }
        ]
      },
      "optional": {
        "vae": [
          "VAE",
          {
            "tooltip": "Video VAE, needed when an image is connected."
          }
        ],
        "audio_vae": [
          "VAE",
          {
            "tooltip": "Audio VAE, needed when an audio is connected."
          }
        ],
        "image": [
          "IMAGE",
          {
            "tooltip": "Image or video frames to anchor. Multi-frame batches are anchored as a clip and cropped down to the model's valid clip lengths: 5, 22, 39... (17k + 5) frames. Batches shorter than 5 frames use only the first image."
          }
        ],
        "audio": [
          "AUDIO",
          {
            "tooltip": "Soundtrack to anchor starting at the same frame index, cropped to the video's remaining duration."
          }
        ]
      }
    },
    "input_order": {
      "required": [
        "positive",
        "latent",
        "frame_idx"
      ],
      "optional": [
        "vae",
        "audio_vae",
        "image",
        "audio"
      ]
    },
    "is_input_list": false,
