        "height": [
          "INT",
          {
            "default": 768,
            "min": 32,
            "max": 16384,
            "step": 32
          }
        ],
        "length": [
          "INT",
          {
            "tooltip": "Frame count at 24 fps, snapped up to the model's 17k+5 grid (124 = ~5s; trained range is ~124-362, longer is untested)",
