  "authored_exclusions": [
    {
      "id": "passable_scenic_decoration_requires_nonblocking_native_pass",
      "primary_classes": ["decoration"],
      "families": ["decoration"],
      "reason": "Recovered native decorative bodies currently own blocking placement only; adding scenic placements would change generation topology."
    },
    {
      "id": "metadata_only_guarded_reward",
      "primary_classes": ["guarded_reward_site"],
      "require_missing_live_guard_contract": true,
      "reason": "The authoritative resource-site defender/reward contract is not executable; stale map-object summary flags do not decide eligibility."
    },
    {
      "id": "pickup_without_live_resource_site",
      "primary_classes": ["pickup"],
      "require_missing_resource_site": true,
      "reason": "The authored object has no live resource-site execution surface."
    },
    {
      "id": "scenario_owned_object",
      "primary_classes": ["scenario_objective", "neutral_encounter"],
      "reason": "Identity depends on authored scenario hooks, encounter payload, or objective state and is not safe for generic RMG use."
    },
    {
      "id": "water_travel_meaning_placement",
      "runtime_statuses": ["water_travel_live"],
      "reason": "Shipyards and whirlpools only work beside or on water; they are placed from HoMM3 Shipyard (87) and Whirlpool (111) by GeneratedRewardRules, never as generic interactable proxies."
    },
    {
      "id": "portal_network_meaning_placement",
      "runtime_statuses": ["portal_network_live"],
      "reason": "Wayrings, Waygates and Wayfalls only work with a native portal network; they are placed from HoMM3 Monoliths (45, 43, 44) by GeneratedRewardRules, never as generic transit proxies."
    }
  ],
