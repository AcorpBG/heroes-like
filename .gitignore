.codex
# RMG evidence here is retained separately; clones need an explicit restore.
# See docs/rmg-evidence-storage.md before cleaning .artifacts/ or tmp/.
.artifacts/
.godot/
*.uid
*.import
!art/towns/runtime/backdrops/*.png.import
!art/towns/runtime/backdrops/third_hearths/*.png.import
!art/towns/runtime/backdrops/complete_identities/*.png.import
!art/towns/runtime/backdrops/development_scenes/*.png.import
!art/towns/runtime/scene_layers/**/*.png.import
!art/ui/main_menu_nano_banana_backdrop.png.import
!art/results/runtime/backdrops/outcome_victory.png.import
!art/results/runtime/backdrops/outcome_defeat.png.import
!art/overworld/runtime/objects/towns/biome_fit/*.png.import
bin/*.so
bin/*.dll.a
# MSVC link and debug byproducts of the Windows native build.
bin/*.pdb
bin/*.exp
bin/*.lib
tmp/
src/gdextension/build/
art/overworld/runtime/homm3_local_prototype/

# Production source media lives in the verified external source archives.
# Keep recipes/provenance and the editor-required sources in Git.
/art/*/source/**/*.7z
/art/*/source/**/*.aiff
/art/*/source/**/*.avi
/art/*/source/**/*.blend
/art/*/source/**/*.bmp
/art/*/source/**/*.exr
/art/*/source/**/*.flac
/art/*/source/**/*.gif
/art/*/source/**/*.gz
/art/*/source/**/*.jpeg
/art/*/source/**/*.jpg
/art/*/source/**/*.kra
/art/*/source/**/*.latent
/art/*/source/**/*.mkv
/art/*/source/**/*.mov
/art/*/source/**/*.mp3
/art/*/source/**/*.mp4
/art/*/source/**/*.npy
/art/*/source/**/*.npz
/art/*/source/**/*.ogg
/art/*/source/**/*.ora
/art/*/source/**/*.png
/art/*/source/**/*.psd
/art/*/source/**/*.safetensors
/art/*/source/**/*.svg
/art/*/source/**/*.tar
/art/*/source/**/*.tif
/art/*/source/**/*.tiff
/art/*/source/**/*.wav
/art/*/source/**/*.webm
/art/*/source/**/*.webp
/art/*/source/**/*.zip
!/art/towns/source/buildings/curated/**/*.png
!/art/campaigns/source/generated/emblems/**/*.png
!/art/campaigns/source/generated/chapter_seals/**/*.png

# Python bytecode from tools, tests and per-unit recipe scripts.
__pycache__/
*.pyc

# Editor/dev runs write generated skirmish packages to res://maps; owner saves
# reference them, so they stay on disk but out of Git. Tracked RMG manual
# inspection fixtures remain versioned.
/maps/*.amap
/maps/*.ascenario
!/maps/manual-strict_*
